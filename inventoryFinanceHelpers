// ─────────────────────────────────────────────────────────────────────────────
// SC.PO Phase 6C — Inventory Financing Helpers
//
// Bridge/marketplace model: SC.PO connects vendor borrowers with licensed
// lenders. Vendors pledge inventory NFTs as collateral for a credit line.
// SC.PO enforces a soft lock (on-chain memo + app-level check).
// Lenders make credit decisions and hold licenses.
//
// ⚠️ LEGAL REVIEW REQUIRED before enabling for real users.
//
// This file provides:
//   1. CreditLine / DrawEvent / RepayEvent — core state types
//   2. CollateralValuation — output of collateral math
//   3. scanCreditLines() — reconstruct credit lines from on-chain memos
//   4. getActiveCreditLines() — filter to active only
//   5. calculateCollateralValue() — pure valuation function
//   6. isPledged() — soft lock check
//   7. computeInterestAccrued() — time-weighted interest
//   8. computeCoverageRatio() — health check with status
// ─────────────────────────────────────────────────────────────────────────────

import * as xrpl from 'xrpl';
import { getXRPLClient } from './xrplHelpers';
import { parseMemo, SCPO_ACTIONS } from './memoHelpers';

// ─────────────────────────────────────────────────────────────────────────────
// § 1 — Core Types
// ─────────────────────────────────────────────────────────────────────────────

/**
 * DrawEvent — a single draw-down against a credit line.
 * Built from COLLATERAL_DRAW memos on-chain.
 */
export interface DrawEvent {
  /** Memo ref — UUID for this draw */
  drawId: string;
  /** RLUSD amount drawn (e.g. "500.00") */
  amount: string;
  /** Running balance after this draw */
  newBalance: string;
  txHash: string;
  /** Unix seconds */
  timestamp: number;
}

/**
 * RepayEvent — a single repayment against a credit line.
 * Built from COLLATERAL_REPAY memos on-chain.
 */
export interface RepayEvent {
  /** Memo ref — UUID for this repayment */
  repayId: string;
  /** Principal portion of this repayment */
  principalAmount: string;
  /** Interest portion of this repayment */
  interestAmount: string;
  /** Running balance after this repayment */
  newBalance: string;
  txHash: string;
  /** Unix seconds */
  timestamp: number;
}

/**
 * CreditLine — a vendor's inventory-backed credit line.
 *
 * Created by COLLATERAL_PLEDGE memo. Updated by DRAW/REPAY/RELEASE/DEFAULT.
 * Soft lock: pledgedNftIds are blocked from certain operations while status === 'active'.
 */
export interface CreditLine {
  /** UUID — the `r` (ref) field in all COLLATERAL_* memos for this line */
  pledgeId: string;

  vendorAddress: string;
  lenderAddress: string;

  /** NFT IDs of inventory items pledged as collateral */
  pledgedNftIds: string[];

  /** USD gross value of pledged inventory at pledge time */
  grossValuation: string;
  /** Haircut fraction applied (e.g. 0.65 = lend 65% of gross value) */
  haircutPct: number;
  /** Max credit available = grossValuation * haircutPct */
  creditLimit: string;

  /** IPFS CID of the financing terms document */
  termsCID: string;

  pledgeTxHash: string;
  /** Unix seconds */
  pledgeTimestamp: number;

  status: 'active' | 'released' | 'defaulted';

  // ── Derived from draw/repay history ────────────────────────────────────────
  /** Cumulative RLUSD drawn (principal only) */
  totalDrawn: string;
  /** Cumulative RLUSD repaid (principal only) */
  totalRepaid: string;
  /** Outstanding principal = totalDrawn - totalRepaid */
  currentBalance: string;
  /**
   * Interest accrued to date — computed at read time via computeInterestAccrued().
   * Not stored on-chain; re-derived on every scan.
   */
  interestAccrued: string;

  draws: DrawEvent[];
  repayments: RepayEvent[];

  // ── Set on release ──────────────────────────────────────────────────────────
  releaseTxHash?: string;
  /** Unix seconds */
  releasedAt?: number;

  // ── Set on default ──────────────────────────────────────────────────────────
  defaultTxHash?: string;
  /** Unix seconds */
  defaultedAt?: number;
}

// ─────────────────────────────────────────────────────────────────────────────
// § 2 — Valuation Types
// ─────────────────────────────────────────────────────────────────────────────

/**
 * CollateralValuationItem — one inventory item's contribution to collateral.
 */
export interface CollateralValuationItem {
  nftId: string;
  partNumber: string;
  name: string;
  qty: number;
  listPrice: number;
  /** qty * listPrice */
  lineValue: number;
}

/**
 * CollateralValuation — output of calculateCollateralValue().
 * Pure computation — no XRPL calls needed.
 */
export interface CollateralValuation {
  /** Sum of (qty * listPrice) across all included items */
  grossValue: number;
  haircutPct: number;
  /** grossValue * haircutPct — maximum credit available */
  lendableValue: number;
  /**
   * grossValue / currentBalance.
   * Infinity if currentBalance === 0 (no outstanding loan).
   * Used to determine margin health.
   */
  coverageRatio: number;
  itemsIncluded: CollateralValuationItem[];
}

/**
 * CoverageStatus — health of a credit line based on coverage ratio.
 */
export interface CoverageStatus {
  ratio: number;
  /** 'healthy' ≥ 1.5x | 'warning' 1.2–1.5x | 'critical' < 1.2x | 'no_balance' no draws */
  status: 'healthy' | 'warning' | 'critical' | 'no_balance';
  label: string;
}

// ─────────────────────────────────────────────────────────────────────────────
// § 3 — Constants
// ─────────────────────────────────────────────────────────────────────────────

/** Default haircut: lend 65% of pledged inventory gross value */
export const DEFAULT_HAIRCUT = 0.65;

/** Coverage ratio thresholds */
export const COVERAGE_HEALTHY  = 1.5;
export const COVERAGE_WARNING  = 1.2;

/** Minimum credit line draw (RLUSD) */
export const MIN_DRAW_AMOUNT = 100;

/** SC.PO fee on credit line disbursements (1%) */
export const CREDIT_LINE_SCPO_FEE = 0.01;

// ─────────────────────────────────────────────────────────────────────────────
// § 4 — Pure Computation Helpers
// ─────────────────────────────────────────────────────────────────────────────

/**
 * calculateCollateralValue
 *
 * Computes the gross and lendable value of a set of inventory items.
 * Uses quantityOnHand (from MPT OutstandingAmount) and listPrice (from vendorDoc).
 *
 * @param items         InventoryItemV2-shaped objects (only needs nftId, partNumber,
 *                      name, quantityOnHand, listPrice)
 * @param haircutPct    Fraction to lend against gross value (default 0.65)
 * @param currentBalance Outstanding loan principal in USD (used for coverage ratio)
 */
export const calculateCollateralValue = (
  items: Array<{
    nftId: string;
    partNumber: string;
    name: string;
    quantityOnHand: number;
    listPrice: number;
  }>,
  haircutPct: number = DEFAULT_HAIRCUT,
  currentBalance: number = 0
): CollateralValuation => {
  const itemsIncluded: CollateralValuationItem[] = [];
  let grossValue = 0;

  for (const item of items) {
    const qty = item.quantityOnHand || 0;
    const price = item.listPrice || 0;
    if (qty <= 0 || price <= 0) continue;

    const lineValue = qty * price;
    grossValue += lineValue;
    itemsIncluded.push({
      nftId:       item.nftId,
      partNumber:  item.partNumber,
      name:        item.name,
      qty,
      listPrice:   price,
      lineValue,
    });
  }

  const lendableValue = grossValue * haircutPct;
  const coverageRatio = currentBalance > 0
    ? grossValue / currentBalance
    : Infinity;

  return { grossValue, haircutPct, lendableValue, coverageRatio, itemsIncluded };
};

/**
 * computeInterestAccrued
 *
 * Time-weighted simple interest on each draw.
 * Interest = principal * APR * (daysElapsed / 365)
 * Subtracts any interest already paid via repayments.
 *
 * @param draws       Draw history for this credit line
 * @param repayments  Repayment history (to subtract already-paid interest)
 * @param apr         Annual percentage rate as decimal (e.g. 0.12 = 12%)
 * @param nowSeconds  Current Unix time (defaults to Date.now() / 1000)
 */
export const computeInterestAccrued = (
  draws: DrawEvent[],
  repayments: RepayEvent[],
  apr: number,
  nowSeconds: number = Math.floor(Date.now() / 1000)
): number => {
  if (!draws.length || apr <= 0) return 0;

  // Sum gross interest on all draws from draw date to now
  let grossInterest = 0;
  for (const draw of draws) {
    const principal = parseFloat(draw.amount) || 0;
    if (principal <= 0) continue;
    const daysElapsed = Math.max(0, (nowSeconds - draw.timestamp) / 86400);
    grossInterest += principal * apr * (daysElapsed / 365);
  }

  // Subtract interest already paid in repayments
  const interestPaid = repayments.reduce(
    (sum, r) => sum + (parseFloat(r.interestAmount) || 0),
    0
  );

  return Math.max(0, grossInterest - interestPaid);
};

/**
 * computeCoverageRatio
 *
 * Returns the coverage ratio and a health status label.
 *
 * @param grossValue      Current gross collateral value (from calculateCollateralValue)
 * @param currentBalance  Outstanding loan principal
 */
export const computeCoverageRatio = (
  grossValue: number,
  currentBalance: number
): CoverageStatus => {
  if (currentBalance <= 0) {
    return { ratio: Infinity, status: 'no_balance', label: 'No Balance' };
  }

  const ratio = grossValue / currentBalance;

  if (ratio >= COVERAGE_HEALTHY) {
    return { ratio, status: 'healthy',  label: `${ratio.toFixed(1)}x ✓` };
  }
  if (ratio >= COVERAGE_WARNING) {
    return { ratio, status: 'warning',  label: `${ratio.toFixed(1)}x ⚠️` };
  }
  return   { ratio, status: 'critical', label: `${ratio.toFixed(1)}x 🚨` };
};

/**
 * isPledged
 *
 * Returns true if the given nftId appears in any active credit line.
 * Use this as the soft lock check before allowing NFT operations.
 *
 * @param nftId       NFT to check
 * @param creditLines All credit lines for this vendor (scan result)
 */
export const isPledged = (
  nftId: string,
  creditLines: CreditLine[]
): boolean => {
  return creditLines.some(
    line => line.status === 'active' && line.pledgedNftIds.includes(nftId)
  );
};

/**
 * getPledgeForNft
 *
 * Returns the active CreditLine that has pledged this NFT, or null.
 * Use to show which credit line is blocking an operation.
 */
export const getPledgeForNft = (
  nftId: string,
  creditLines: CreditLine[]
): CreditLine | null => {
  return creditLines.find(
    line => line.status === 'active' && line.pledgedNftIds.includes(nftId)
  ) ?? null;
};

/**
 * getAvailableCredit
 *
 * Returns available credit = creditLimit - currentBalance.
 * Clamped to 0 (never negative).
 */
export const getAvailableCredit = (line: CreditLine): number => {
  const limit   = parseFloat(line.creditLimit)   || 0;
  const balance = parseFloat(line.currentBalance) || 0;
  return Math.max(0, limit - balance);
};

/**
 * formatCreditLineId
 *
 * Returns a short display ID for a pledge (first 8 chars of UUID).
 */
export const formatCreditLineId = (pledgeId: string): string =>
  `CL-${pledgeId.slice(0, 8).toUpperCase()}`;

// ─────────────────────────────────────────────────────────────────────────────
// § 5 — On-Chain Scanner
// ─────────────────────────────────────────────────────────────────────────────

/**
 * scanCreditLines
 *
 * Reconstructs all credit lines for a vendor from on-chain COLLATERAL_* memos.
 * Processes transactions oldest-first so COLLATERAL_PLEDGE always initialises
 * the Map entry before DRAW/REPAY/RELEASE/DEFAULT update it.
 *
 * Pattern mirrors scanFinancingRequests in financeHelpers.ts.
 *
 * @param vendorAddress  Vendor wallet to scan
 */
export const scanCreditLines = async (
  vendorAddress: string
): Promise<CreditLine[]> => {
  const lines = new Map<string, CreditLine>();

  try {
    const client = await getXRPLClient();
    const resp = await client.request({
      command: 'account_tx',
      account: vendorAddress,
      ledger_index_min: -1,
      ledger_index_max: -1,
      limit: 400,
    });

    // account_tx returns newest-first — reverse so PLEDGE is always
    // processed before any subsequent DRAW/REPAY/RELEASE/DEFAULT
    const sortedTxs = [...(resp.result.transactions || [])].reverse();

    for (const txEntry of sortedTxs) {
      const tx = (txEntry as any).tx_json || (txEntry as any).tx || {};
      if (!tx?.Memos?.length) continue;

      for (const memoWrapper of tx.Memos) {
        const memo = parseMemo(memoWrapper.Memo);
        if (!memo) continue;

        const action    = memo.a as string;
        const payload   = memo.p as any;
        const ref       = memo.r as string;
        const hash      = (txEntry as any).hash || tx.hash || '';
        const closeTime = (txEntry as any).close_time_iso || null;
        const timestamp = closeTime
          ? Math.floor(new Date(closeTime).getTime() / 1000)
          : Math.floor(Date.now() / 1000);

        // ── COLLATERAL_PLEDGE — initialise credit line ────────────────────
        if (action === SCPO_ACTIONS.COLLATERAL_PLEDGE) {
          const pledgeId = ref;
          if (!lines.has(pledgeId)) {
            const grossVal  = parseFloat(payload.valuation || '0');
            const haircut   = payload.haircut ?? DEFAULT_HAIRCUT;
            const lineAmt   = payload.lineAmt
              || (grossVal * haircut).toFixed(2);

            lines.set(pledgeId, {
              pledgeId,
              vendorAddress,
              lenderAddress:    payload.lender    || '',
              pledgedNftIds:    payload.nfts       || [],
              grossValuation:   payload.valuation  || '0',
              haircutPct:       haircut,
              creditLimit:      lineAmt,
              termsCID:         payload.termsCID   || '',
              pledgeTxHash:     hash,
              pledgeTimestamp:  timestamp,
              status:           'active',
              totalDrawn:       '0',
              totalRepaid:      '0',
              currentBalance:   '0',
              interestAccrued:  '0',
              draws:            [],
              repayments:       [],
            });
          }
        }

        // ── COLLATERAL_DRAW — record a draw-down ──────────────────────────
        if (action === SCPO_ACTIONS.COLLATERAL_DRAW) {
          const pledgeId = payload.pledgeId || ref;
          const existing = lines.get(pledgeId);
          if (existing) {
            const drawAmt   = parseFloat(payload.drawAmt || '0');
            const newTotalDrawn = (parseFloat(existing.totalDrawn) + drawAmt).toFixed(2);
            const newBalance    = payload.newBal
              || (parseFloat(existing.currentBalance) + drawAmt).toFixed(2);

            existing.draws.push({
              drawId:     ref,
              amount:     payload.drawAmt || '0',
              newBalance,
              txHash:     hash,
              timestamp,
            });
            existing.totalDrawn     = newTotalDrawn;
            existing.currentBalance = newBalance;
            lines.set(pledgeId, existing);
          }
        }

        // ── COLLATERAL_REPAY — record a repayment ─────────────────────────
        if (action === SCPO_ACTIONS.COLLATERAL_REPAY) {
          const pledgeId = payload.pledgeId || ref;
          const existing = lines.get(pledgeId);
          if (existing) {
            const principalAmt = parseFloat(payload.repayAmt || '0');
            const interestAmt  = parseFloat(payload.intAmt   || '0');
            const newTotalRepaid = (parseFloat(existing.totalRepaid) + principalAmt).toFixed(2);
            const newBalance     = payload.newBal
              || Math.max(0, parseFloat(existing.currentBalance) - principalAmt).toFixed(2);

            existing.repayments.push({
              repayId:         ref,
              principalAmount: payload.repayAmt || '0',
              interestAmount:  payload.intAmt   || '0',
              newBalance,
              txHash:          hash,
              timestamp,
            });
            existing.totalRepaid    = newTotalRepaid;
            existing.currentBalance = newBalance;
            lines.set(pledgeId, existing);
          }
        }

        // ── COLLATERAL_RELEASE — mark line as released ─────────────────────
        if (action === SCPO_ACTIONS.COLLATERAL_RELEASE) {
          const pledgeId = payload.pledgeId || ref;
          const existing = lines.get(pledgeId);
          if (existing) {
            existing.status        = 'released';
            existing.releaseTxHash = hash;
            existing.releasedAt    = timestamp;
            lines.set(pledgeId, existing);
          }
        }

        // ── COLLATERAL_DEFAULT — mark line as defaulted ────────────────────
        if (action === SCPO_ACTIONS.COLLATERAL_DEFAULT) {
          const pledgeId = payload.pledgeId || ref;
          const existing = lines.get(pledgeId);
          if (existing) {
            existing.status       = 'defaulted';
            existing.defaultTxHash = hash;
            existing.defaultedAt  = timestamp;
            lines.set(pledgeId, existing);
          }
        }
      }
    }
  } catch (err) {
    console.error('[scanCreditLines] scan failed:', err);
  }

  // Hydrate interestAccrued on all active lines before returning.
  // APR is not stored in the pledge memo — it comes from the terms doc.
  // For MVP we derive a placeholder (0) here; the UI layer passes the
  // known APR from the lender's approval memo into computeInterestAccrued
  // directly when displaying a credit line detail.
  const now = Math.floor(Date.now() / 1000);
  for (const [pledgeId, line] of lines) {
    if (line.status === 'active' && line.draws.length > 0) {
      // APR unknown at scan time without fetching the terms doc —
      // set to 0 here; caller should call computeInterestAccrued(line.draws,
      // line.repayments, knownAPR) when they have the rate available.
      line.interestAccrued = '0';
    }
    lines.set(pledgeId, line);
  }

  // Return newest-first (most recent pledge at top)
  return Array.from(lines.values()).sort(
    (a, b) => b.pledgeTimestamp - a.pledgeTimestamp
  );
};

/**
 * getActiveCreditLines
 *
 * Convenience wrapper — returns only lines with status === 'active'.
 */
export const getActiveCreditLines = async (
  vendorAddress: string
): Promise<CreditLine[]> => {
  const all = await scanCreditLines(vendorAddress);
  return all.filter(line => line.status === 'active');
};

// ─────────────────────────────────────────────────────────────────────────────
// § 6 — Display Helpers
// ─────────────────────────────────────────────────────────────────────────────

/**
 * formatCreditLineStatus
 *
 * Returns a human-readable status label with emoji for UI badges.
 */
export const formatCreditLineStatus = (
  status: CreditLine['status']
): string => {
  switch (status) {
    case 'active':    return '● Active';
    case 'released':  return '✓ Released';
    case 'defaulted': return '⚠️ Defaulted';
    default:          return status;
  }
};

/**
 * formatCreditLineSummary
 *
 * Returns a one-line summary string for list views.
 * e.g. "Limit $10,000 | Balance $4,200 | Available $5,800"
 */
export const formatCreditLineSummary = (line: CreditLine): string => {
  const limit     = parseFloat(line.creditLimit)    || 0;
  const balance   = parseFloat(line.currentBalance) || 0;
  const available = Math.max(0, limit - balance);
  const fmt = (n: number) =>
    n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 });
  return `Limit ${fmt(limit)} | Balance ${fmt(balance)} | Available ${fmt(available)}`;
};
