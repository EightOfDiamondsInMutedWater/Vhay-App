import React, { useState, useEffect } from 'react';
import * as xrpl from 'xrpl';
import type { EscrowCreate, NFTokenMint, EscrowFinish, NFTokenCreateOffer, NFTokenAcceptOffer, Payment } from 'xrpl';
import { Buffer } from 'buffer';

interface Item {
  num: string;
  qty: string;
  total: string;
}

interface Attachment {
  name: string;
  uri: string;
}

interface POData {
  poName: string;
  description: string;
  department: string;
  paymentTerms: string;
  deliveryTerms: string;
  items: Item[];
  escrowCondition: string;
  attachments?: Attachment[];
}

interface SavedPO {
  id: string;
  poName: string;
  dateIssued: string;
  total: string;
  ipfsUri: string;
  status: 'Open' | 'Accepted' | 'Closed';
  nftId: string;
  escrowSequence: number;
  condition: string;
  fulfillment: string;
  offerIndex: string;
  buyerAddress: string;
  vendorAddress: string;
}

interface Profile {
  company: string;
  name: string;
  address: string;
  city: string;
  state: string;
  zip: string;
  country: string;
  seed: string;
  classicAddress: string;
  uniqueID: string;
}

interface PublicProfile {
  company: string;
  name: string;
  address: string;
  city: string;
  state: string;
  zip: string;
  country: string;
  uniqueID: string;
  classicAddress: string;
}

interface FeeEntry {
  date: string;
  poName: string;
  amount: string;
  txHash: string;
}

export default function App() {
  const [activeTab, setActiveTab] = useState<'create' | 'view' | 'vendor' | 'customerProfile' | 'vendorProfile' | 'admin'>('create');

  // Create Tab
  const [poName, setPoName] = useState('');
  const [seed, setSeed] = useState('');
  const [vendor, setVendor] = useState('');
  const [desc, setDesc] = useState('');
  const [department, setDepartment] = useState('1');
  const [paymentTerms, setPaymentTerms] = useState('30 Days');
  const [deliveryTerms, setDeliveryTerms] = useState('FOB');
  const [result, setResult] = useState('');
  const [items, setItems] = useState<Item[]>([{ num: 'T345', qty: '4', total: '400' }]);
  const [newItemNum, setNewItemNum] = useState('');
  const [newQty, setNewQty] = useState('');
  const [newTotal, setNewTotal] = useState('');
  const [totalEscrowAmount, setTotalEscrowAmount] = useState('400');
  const [selectedFiles, setSelectedFiles] = useState<FileList | null>(null);
  const [scpoSuccess, setScpoSuccess] = useState(false);

  // Admin
  const [adminLoggedIn, setAdminLoggedIn] = useState(false);
  const [adminPassword, setAdminPassword] = useState('');
  const [feeEntries, setFeeEntries] = useState<FeeEntry[]>([]);

  // View
  const [openExpanded, setOpenExpanded] = useState(false);
  const [acceptedExpanded, setAcceptedExpanded] = useState(false);
  const [closedExpanded, setClosedExpanded] = useState(false);

  // Vendor tab
  const [claimSeed, setClaimSeed] = useState('');
  const [claimFulfillment, setClaimFulfillment] = useState('');
  const [claimCondition, setClaimCondition] = useState('');
  const [claimOwner, setClaimOwner] = useState('');
  const [claimOfferSequence, setClaimOfferSequence] = useState('');
  const [claimResult, setClaimResult] = useState('');
  const [vendorAcceptSeed, setVendorAcceptSeed] = useState('');
  const [offerIndex, setOfferIndex] = useState('');
  const [acceptResult, setAcceptResult] = useState('');
  const [selectedOpenPO, setSelectedOpenPO] = useState<SavedPO | null>(null);
  const [selectedAcceptedPO, setSelectedAcceptedPO] = useState<SavedPO | null>(null);

  // View PO
  const [ipfsUri, setIpfsUri] = useState('');
  const [viewedPO, setViewedPO] = useState<POData | null>(null);
  const [poLoadError, setPoLoadError] = useState<string | null>(null);

  // Saved POs
  const [savedPOs, setSavedPOs] = useState<SavedPO[]>([]);

  // Profiles & Linking
  const [customerProfile, setCustomerProfile] = useState<Profile>({ company: '', name: '', address: '', city: '', state: '', zip: '', country: '', seed: '', classicAddress: '', uniqueID: '' });
  const [vendorProfile, setVendorProfile] = useState<Profile>({ company: '', name: '', address: '', city: '', state: '', zip: '', country: '', seed: '', classicAddress: '', uniqueID: '' });
  const [linkedVendors, setLinkedVendors] = useState<PublicProfile[]>([]);
  const [linkedCustomers, setLinkedCustomers] = useState<PublicProfile[]>([]);
  const [customerShareCode, setCustomerShareCode] = useState('');
  const [vendorShareCode, setVendorShareCode] = useState('');
  const [inputVendorCode, setInputVendorCode] = useState('');
  const [inputCustomerCode, setInputCustomerCode] = useState('');

  // Load from localStorage
  useEffect(() => {
    const loadedPOs = localStorage.getItem('savedPOs');
    if (loadedPOs) setSavedPOs(JSON.parse(loadedPOs));

    const loadedFees = localStorage.getItem('feeEntries');
    if (loadedFees) setFeeEntries(JSON.parse(loadedFees));

    const loadedCustomer = localStorage.getItem('customerProfile');
    if (loadedCustomer) setCustomerProfile(JSON.parse(loadedCustomer));

    const loadedVendor = localStorage.getItem('vendorProfile');
    if (loadedVendor) setVendorProfile(JSON.parse(loadedVendor));

    const loadedVendors = localStorage.getItem('linkedVendors');
    if (loadedVendors) setLinkedVendors(JSON.parse(loadedVendors));

    const loadedCustomers = localStorage.getItem('linkedCustomers');
    if (loadedCustomers) setLinkedCustomers(JSON.parse(loadedCustomers));
  }, []);

  // Auto-fill seeds/addresses
  useEffect(() => {
    if (customerProfile.seed) setSeed(customerProfile.seed);
    if (vendorProfile.seed) {
      setVendorAcceptSeed(vendorProfile.seed);
      setClaimSeed(vendorProfile.seed);
    }
  }, [customerProfile, vendorProfile]);

  // Save linked lists
  useEffect(() => localStorage.setItem('linkedVendors', JSON.stringify(linkedVendors)), [linkedVendors]);
  useEffect(() => localStorage.setItem('linkedCustomers', JSON.stringify(linkedCustomers)), [linkedCustomers]);

  // Calculate total
  useEffect(() => {
    const total = items.reduce((sum, item) => sum + parseFloat(item.total || '0'), 0);
    setTotalEscrowAmount(total.toString());
  }, [items]);

  const addItem = () => {
    if (newItemNum && newQty && newTotal) {
      setItems([...items, { num: newItemNum, qty: newQty, total: newTotal }]);
      setNewItemNum(''); setNewQty(''); setNewTotal('');
    }
  };

  const removeItem = (index: number) => setItems(items.filter((_, i) => i !== index));

  const saveCustomerProfile = () => { localStorage.setItem('customerProfile', JSON.stringify(customerProfile)); alert('Saved!'); };
  const saveVendorProfile = () => { localStorage.setItem('vendorProfile', JSON.stringify(vendorProfile)); alert('Saved!'); };

  const generateCustomerShareCode = () => {
    const pub = { ...customerProfile };
    setCustomerShareCode(btoa(JSON.stringify(pub)));
  };

  const generateVendorShareCode = () => {
    const pub = { ...vendorProfile };
    setVendorShareCode(btoa(JSON.stringify(pub)));
  };

  const addLinkedVendor = () => {
    try {
      const decoded = JSON.parse(atob(inputVendorCode));
      if (!linkedVendors.some(v => v.uniqueID === decoded.uniqueID)) {
        setLinkedVendors([...linkedVendors, decoded]);
        setInputVendorCode('');
        alert('Vendor linked');
      }
    } catch { alert('Invalid code'); }
  };

  const addLinkedCustomer = () => {
    try {
      const decoded = JSON.parse(atob(inputCustomerCode));
      if (!linkedCustomers.some(c => c.uniqueID === decoded.uniqueID)) {
        setLinkedCustomers([...linkedCustomers, decoded]);
        setInputCustomerCode('');
        alert('Customer linked');
      }
    } catch { alert('Invalid code'); }
  };

  // ... (keep all XRPL functions exactly as in previous full versions: generateConditionFulfillment, uploadToIPFS, createSCPO, acceptNFT, claimEscrow, etc.)

  // When selecting an accepted PO, pull buyerAddress from the PO
  const handleAcceptedPOSelect = (e: React.ChangeEvent<HTMLSelectElement>) => {
    const po = savedPOs.find(p => p.id === e.target.value) || null;
    setSelectedAcceptedPO(po);
    if (po) {
      setClaimFulfillment(po.fulfillment);
      setClaimCondition(po.condition);
      setClaimOfferSequence(po.escrowSequence.toString());
      setClaimOwner(po.buyerAddress);  // This is the key fix
    }
  };

  const handleMouseEnter = (e: React.MouseEvent<HTMLButtonElement>) => { /* same as before */ };
  const handleMouseLeave = (e: React.MouseEvent<HTMLButtonElement>) => { /* same */ };

  return (
    <div style={{ display: 'flex', minHeight: '100vh', background: '#f5f5f5' }}>
      {/* Sidebar - same as before */}

      <div style={{ marginLeft: '250px', padding: '40px', width: '100%' }}>
        <h1 style={{ textAlign: 'center', color: '#D4AF37' }}>SC.PO Generator</h1>

        {activeTab === 'create' && (
          // Full Create tab JSX - same as before, with vendor dropdown from linkedVendors
        )}

        {activeTab === 'view' && (
          // Full View tab JSX
        )}

        {activeTab === 'vendor' && (
          // Full Vendor Claim tab
          <select onChange={handleAcceptedPOSelect}> {/* use the new handler */}
            {/* options */}
          </select>
          // rest of inputs (claimOwner now auto-filled from PO)
        )}

        {activeTab === 'customerProfile' && (
          <div style={{ maxWidth: '900px', margin: '0 auto', background: '#FFF9E6', padding: '30px', borderRadius: '20px' }}>
            {/* all profile inputs */}
            <h3 style={{ textAlign: 'center' }}>Generate Share Code</h3>
            <button onClick={generateCustomerShareCode}>Generate Code</button>
            {customerShareCode && (
              <div style={{ maxWidth: '600px', margin: '20px auto', textAlign: 'center' }}>
                <pre style={{ background: '#f0f0f0', padding: '15px', borderRadius: '15px', whiteSpace: 'pre-wrap', wordBreak: 'break-all' }}>
                  {customerShareCode}
                </pre>
                <button onClick={() => navigator.clipboard.writeText(customerShareCode)}>Copy</button>
              </div>
            )}
            {/* linking section */}
          </div>
        )}

        {activeTab === 'vendorProfile' && (
          // Same pattern as customerProfile, with wrapping pre tag for vendorShareCode
        )}

        {activeTab === 'admin' && (
          // Full Admin tab
        )}
      </div>
    </div>
  );
}

